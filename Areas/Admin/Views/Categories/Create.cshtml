@{
}
@model Next_Store.Models.CategoryModel
<h1 class="display-4">Create a Category</h1>
<div class="col-md-10">
<form method="post" asp-controller="Categories" asp-action="Create">
    <div class="form-control">
    <label asp-for="Name">Name</label>
    <input type="text" asp-for="Name" class="form-control"/>
    <span asp-validation-for="Name" class="text-bg-danger"></span>
        </div>
        
        <div class="form-group">
            <input type="submit" value="Create" class="btn-primary"/>
        </div>
</form>
    <a asp-controller="Categories" asp-action="Index">Back to List</a>
</div>

