@{
}

@model Next_Store.Models.CategoryModel
<h1 class="display-4">Category</h1>
<table class="table">
    <tr>
    <th>Name</th>
    <th>Slug</th>
    </tr>
    <tr>
           <td>@Model.Name</td>
           <td>@Model.Slug</td>
           <td>
               <a asp-action="Edit" asp-route-id=@Model.Id>Edit</a> |
               <a asp-action="Delete" asp-route-id=@Model.Id>Delete</a> |
           </td>
  </tr>
</table>
