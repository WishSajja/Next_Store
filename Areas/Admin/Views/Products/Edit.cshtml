@{
}
@model Next_Store.Models.ProductsModel
<h1 class="display-4">Edit Product</h1>
<div class="col-md-10">
    <form method="post" asp-controller="Products" asp-action="Edit" enctype="multipart/form-data">
        <input type="hidden" asp-for="Image"/>
        
        <div class="form-control">
            <label asp-for="Name">Name</label>
            <input type="text" asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-bg-danger"></span>
        </div>
        <div class="form-control">
            <label asp-for="Description">Description</label>
            <textarea cols="50" asp-for="Description" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-bg-danger"></span>
        </div>
        <div class="form-control">
            <label asp-for="Price">Title</label>
            <input type="text" asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-bg-danger"></span>
        </div>
        <div class="form-control">
            <label asp-for="CategoryId"></label>
           
            <select asp-for="CategoryId" asp-items="@ViewBag.CategoryId">
                <option value="0">Choose a Category</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-bg-danger"></span>
        </div>
        <div class="form-control">
            <label asp-for="Image" >Current</label>
            <img src="/Media/Products/@Model.Image" alt="" width="200" />
        </div>
        <div class="form-control">
            <label asp-for="ImageUpload">Select new Image</label>
            <input type="file" asp-for="ImageUpload" class="form-control" />
            <img src="" id="imgpreview" alt="Product image preview" class="pt-2" />
            <span asp-validation-for="ImageUpload" class="text-bg-danger"></span>
        </div>
        <div class="form-group">
            <input type="submit" value="Edit" class="btn-primary" />
        </div>
    </form>
    <a asp-controller="Page" asp-action="Index">Back to List</a>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        CKEDITOR.replace("Description");

        $("#ImageUpload").change(function(){
            readURL(this);
        });
    </script>
}
