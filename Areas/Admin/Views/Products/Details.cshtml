@{
}

@model Next_Store.Models.ProductsModel
<h1 class="display-4">Product details</h1>
<table class="table">
    <tr>
    <th >Id</th>
    <th>Name</th>
    <th>Slug</th>
    <th>Descripton</th>
        <th>Price</th>
        <th>Category</th>
    <th>Image</th>
    </tr>
    <tr>
           <td>@Model.Id</td>
           <td>@Model.Name</td>
           <td>@Model.Slug</td>
           <td>@Model.Description</td>
           <td>@($"UGX{Model.Price:N0}")</td>
           <td>@Model.Category.Name</td>
           <td>
               <img src="/Media/Products/@Model.Image" width="200" alt="@Model.Image" class="rounded-5"/>
           </td>
           <td>
               <a asp-action="Edit" asp-route-id=@Model.Id>Edit</a> |
               <a asp-action="Index">Back to List</a> |
               <a asp-action="Delete" asp-route-id=@Model.Id>Delete</a> |
           </td>
  </tr>
</table>
