
@model List<AppUser>
<h1 class="display-4">Users</h1>
<table class="table">
    <tr>
        <th>User_id</th>
        <th>Name</th>
        <th>Email</th>
       
    </tr>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Id</td>
                <td>@product.UserName</td>
                <td>@product.Email</td>
                
            </tr>
        }
    </tbody>
</table>

