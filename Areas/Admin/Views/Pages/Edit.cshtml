@{
}
@model Next_Store.Models.Page
<h1>Edit a page</h1>
<div class="col-md-10">
    <form method="post" asp-controller="Pages" asp-action="Edit">
        <input type="hidden" asp-for="Id"/>
        <input type="hidden" asp-for="Sorting"/>
        <div class="form-control">
            <label asp-for="Title">Title</label>
            <input type="text" asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-bg-danger"></span>
        </div>
        <div class="form-control">
            <label asp-for="Content">Content</label>
            <textarea cols="50" asp-for="Content" class="form-control"></textarea>
            <span asp-validation-for="Content" class="text-bg-danger"></span>
        </div>
        <div class="form-group">
            <input type="submit" value="Edit" class="btn-primary" />
        </div>
    </form>
    <a asp-action="Index">Back to List</a>
</div>
@section Scripts
{
<script>
    CKEDITOR.replace("Content");
</script>
}
