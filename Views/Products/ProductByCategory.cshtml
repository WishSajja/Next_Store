@model List<ProductsModel>
@{
	ViewData["Title"]="Categories";
}
<h1 class="display-4">@ViewBag.CategoryName</h1>
<div class="row">
	@foreach (var product in Model)
	{
		<div class="col-4" style="position:relative">
			<div class="ajaxbg">
				<img src="~/images/giphy-17mnccku1mjlrbxodo.gif" />
				<p class="lead alert alert-success d-none">Product added!</p>
			</div>
			<img src="~/Media/Products/@product.Image" class="rounded-5" alt="" width="200" />
			<h4>@product.Name</h4>
			<div>@product.Description
			</div>
			<p>@($"UGX {product.Price}")</p>
			<a asp-controller="Cart" asp-action="Add" asp-route-id="@product.Id" data-id="@product.Id" class="btn btn-primary addToCart">Add to cart</a>

		</div>
	}
	
</div>
@if (ViewBag.TotalPages > 1)
{
	<div class="d-flex justify-content-center">
		<pagination page-count="ViewBag.TotalPages"
					page-number="ViewBag.PageNumber"
					page-target="/Products/Index"
					page-range="ViewBag.PageRange"></pagination>
	</div>
}
@section Scripts {
	<script>
		$(function() {

			$("a.addToCart").click(function(e) {
				e.preventDefault();
				let ajaxDiv =$(this).parent().parent().find("div.ajaxbg");
				ajaxDiv.removeClass("d-none");
				let id = $(this).data("id");
				$.get('/Cart/add/' + id, {}, function(data){
					$("div.smallcart").html(data);
                    ajaxDiv.find("img").addClass("d-none");
                    ajaxDiv.find("p").removeClass("d-none");
					setTimeout(() => {
						ajaxDiv.animate({opacity: 0}, function (){
						    $(this).addClass("d-none").fadeTo(.1, 1);
						    $(this).find("img").removeClass("d-none");
						    $(this).find("p").addClass("d-none");
						});
					
					});
				});
			});

		});
	</script>
}